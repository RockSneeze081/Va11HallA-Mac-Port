@@ -8129,6 +8129,26 @@ static RValue builtin_game_end(VMContext* ctx, MAYBE_UNUSED RValue* args, MAYBE_
     runner->shouldExit = true;
     return RValue_makeUndefined();
 }
+
+// Was previously entirely unregistered (fell through the VM's generic "unknown function"
+// fallback, which just returns undefined and keeps executing). Real GameMaker's show_error
+// halts the game when abort=true - GML error-recovery paths that call it to bail out of a
+// broken state (e.g. a missing optional data file) rely on it actually stopping execution.
+// Silently continuing past it left the caller running with no fallback logic, which one such
+// path (VA-11 Hall-A's textbox_find_pointer_line, triggered by a missing script file) turned
+// into a busy-loop that never yielded back to the run loop - 100% CPU on the main thread and
+// a black/frozen window, confirmed via `sample`. Real GameMaker shows a dialog too, but the
+// log message plus actually stopping is what the caller structurally depends on.
+static RValue builtin_show_error(VMContext* ctx, RValue* args, int32_t argCount) {
+    const char* message = (argCount > 0 && args[0].type == RVALUE_STRING) ? args[0].string : "(no message)";
+    bool doAbort = argCount > 1 && RValue_toBool(args[1]);
+    logError("show_error: %s\n", message);
+    if (doAbort) {
+        Runner* runner = ctx->runner;
+        runner->shouldExit = true;
+    }
+    return RValue_makeUndefined();
+}
 STUB_RETURN_UNDEFINED(game_save)
 STUB_RETURN_UNDEFINED(game_load)
 
