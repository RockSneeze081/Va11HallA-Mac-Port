+// The game draws its own cursor sprite (real mouse position is tracked regardless via
+// RunnerMouse_*, unaffected by this - AppKit's system cursor is a purely visual overlay on
+// top), so leaving the OS arrow cursor visible too gives a distracting double-cursor look.
+// This is the standard AppKit way to swap a view's cursor - an NSCursor tied to a cursor rect
+// via resetCursorRects, which the window server manages automatically on enter/exit/resize -
+// rather than manually balancing -[NSCursor hide]/-unhide against mouse-enter/exit events,
+// which is easy to get out of sync (e.g. one swallowed exit event leaves the pointer hidden
+// forever, even outside the window).
+- (void)resetCursorRects
+{
+    [super resetCursorRects];
+    NSImage *blank = [[NSImage alloc] initWithSize:NSMakeSize(1, 1)];
+    NSCursor *invisibleCursor = [[NSCursor alloc] initWithImage:blank hotSpot:NSZeroPoint];
+    [self addCursorRect:self.bounds cursor:invisibleCursor];
+}
