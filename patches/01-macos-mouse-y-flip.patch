 void platformGetMousePos(double *xPos, double *yPos) {
     NSPoint mouseLocation = [window mouseLocationOutsideOfEventStream];
+    // AppKit's window/view coordinate space is bottom-up (origin at the bottom-left, Y grows
+    // upward); every other backend (glfw's glfwGetCursorPos, SDL's SDL_GetMouseState) reports
+    // mouse position top-down like the game expects (origin at the top-left, Y grows downward).
+    // Flip against the content view's height so this backend matches the others.
+    NSRect bounds = [glView bounds];
     *xPos = mouseLocation.x;
-    *yPos = mouseLocation.y;
+    *yPos = bounds.size.height - mouseLocation.y;
 }
 
